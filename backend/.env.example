# Application Configuration
APP_NAME="TexVantage AI"
APP_ENV="development"
DEBUG=True
API_PREFIX="/api"

# Security & Authentication
JWT_SECRET_KEY="dev_jwt_secret_change_in_production_super_secure_key_12345"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (Development default: sqlite:///./texvantage.db, Production: mssql+pyodbc://...)
DATABASE_URL="sqlite:///./texvantage_dev.db"

# AI Provider Configuration (Backend Only - Never exposed to frontend)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Demo Mode Configuration
ENABLE_DEMO_SWITCHER=True
