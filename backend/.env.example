# Application Configuration
APP_NAME="TexVantage AI"
APP_ENV="development"
DEBUG=True
API_PREFIX="/api"

# Security & Authentication
JWT_SECRET_KEY="dev_jwt_secret_change_in_production_super_secure_key_12345"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration. Local SQL Server uses Windows Authentication; no password is stored.
# For isolated SQLite tests only, override with sqlite:///./texvantage_dev.db.
DATABASE_URL="mssql+pyodbc://@localhost/texvantage?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes"
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# AI Provider Configuration (Backend Only - Never exposed to frontend)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Demo Mode Configuration
ENABLE_DEMO_SWITCHER=True
